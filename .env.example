# The gateway key. Read-only calls work without one; anything that spends
# balance needs it. Make one at orbio.so or with orbio_create_key over MCP.
ORBIO_API_KEY=

# The wallet that signs. Only needed for on-chain actions: buying CREDIT,
# activating it, staking, and the agent launchpad.
#
# Prefer passing a viem Account to createOrbio() from a keystore or an HSM.
# This variable exists because people will use it anyway, and a documented
# path is safer than an undocumented one. Use a wallet that holds what this
# agent needs and nothing more.
ORBIO_PRIVATE_KEY=

# Override where the SDK looks. Unset, it uses Orbio's production hosts, and
# every address and price is fetched from there rather than compiled in.
# ORBIO_BASE_URL=https://api.orbio.so
# ORBIO_RPC_URL=
